# ============================================================
# CampusCode — Production & Local Environment Variables
# ============================================================
# Copy this file to .env.local for local development.
# In production, set these variables in your hosting dashboard (Vercel, Railway, Render).

# ── Cloud PostgreSQL Database ────────────────────────────────
# For Managed Cloud PostgreSQL (Neon, Supabase, Railway):
#
# Neon (Serverless Postgres):
# DATABASE_URL="postgresql://neondb_owner:[PASSWORD]@[HOST].neon.tech/neondb?sslmode=require"
#
# Supabase (Managed Postgres with connection pooling):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
#
# Railway (Managed Postgres):
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST].railway.app:5432/railway"
#
# Local PostgreSQL Development:
DATABASE_URL="postgresql://user:password@localhost:5432/campuscode"

# ── Authentication (NextAuth.js / Auth.js) ──────────────────
# Generate a secure 32+ char secret in terminal: openssl rand -base64 32
NEXTAUTH_SECRET="generate-a-secure-random-secret-key-for-production"
# Set to your production domain (e.g., https://campuscode.dev) or http://localhost:3000 in dev
NEXTAUTH_URL="http://localhost:3000"

# ── Application Configuration ──────────────────────────────
# Public production URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="CampusCode"
NODE_ENV="development"

# ── Google OAuth (Optional) ─────────────────────────────────
# Get credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── GitHub OAuth & API (Optional) ───────────────────────────
# Get credentials from https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_ACCESS_TOKEN=""
# Fine-grained token with repository Issues read/write access. Used by the two-way project sync.
GITHUB_TOKEN=""
# Secret configured on the GitHub repository webhook. The webhook URL is /api/github/webhook.
GITHUB_WEBHOOK_SECRET=""
# GitHub App connection (recommended): users install the app and select permitted repositories.
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
# Store this private key as a single escaped environment variable (replace newlines with \n).
GITHUB_APP_PRIVATE_KEY=""

# ── Razorpay Payment Gateway (Optional / Mock Available) ───
# Get keys from https://dashboard.razorpay.com/
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── AI Services (Optional / Mock Available) ─────────────────
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ── Cloud Object Storage (S3 / Cloudflare R2) ───────────────
S3_BUCKET="campuscode-uploads"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_ENDPOINT=""

# ── Transactional Email (Resend / SMTP) ─────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@campuscode.dev"
